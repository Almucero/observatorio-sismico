# Copiar a .env y ajustar. No subir .env a Git.

POSTGRES_USER=observatorio
POSTGRES_PASSWORD=cambialo_en_local
POSTGRES_DB=observatorio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

KAFKA_BOOTSTRAP=kafka:19092
KAFKA_TOPIC_LIVE=terremotos.live
KAFKA_TOPIC_REPLAY=terremotos.replay

USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
PRODUCER_POLL_SECONDS=60

# Fuentes adicionales opcionales. Vacío: el productor solo consulta USGS
EXTRA_SOURCES=geonet,nrcan,usp,kagsr,emsc,isc

API_HOST=0.0.0.0
API_PORT=8000
# Desarrollo + origen Netlify exacto en publicación (sin /* ni *)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Solo local — NUNCA subir a Git
# NGROK_AUTHTOKEN=
